{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "echo 'node node_modules/pre-commit && git update-index --again' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "generate-icons": "svg2png -c svg2png.config.json -n '' -f src/assets/gin-rummy-scoreboard.svg",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts,.vue --fix --max-warnings=0",
    "format": "prettier --log-level warn --write ."
  },
  "pre-commit": [
    "format",
    "lint"
  ],
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@xstate/vue": "^5.0.0",
    "canvas-confetti": "^1.9.4",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "workbox-window": "^7.4.1",
    "xstate": "^5.32.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@playwright/test": "^1.61.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "pre-commit": "^2.0.0",
    "prettier": "^3.8.4",
    "prettier-plugin-sh": "^0.18.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
