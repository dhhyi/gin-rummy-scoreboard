{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.schema.json",
  "name": "gin-rummy-scoreboard",
  "runArgs": ["--name", "gin-rummy-scoreboard-${devcontainerId}"],
  "mounts": [
    "type=volume,target=${containerWorkspaceFolder}/node_modules,source=gin-rummy-scoreboard-node-modules",
    "type=volume,target=${containerWorkspaceFolder}/.pnpm-store,source=pnpm-store",
    "type=volume,target=/home/vscode/.cache/ms-playwright,source=playwright-cache",
    "type=volume,target=/home/vscode/.cache/mise,source=mise-cache"
  ],
  "postCreateCommand": "sudo install -d -o vscode -g vscode node_modules .pnpm-store /home/vscode /home/vscode/.cache /home/vscode/.cache/ms-playwright /home/vscode /home/vscode/.cache /home/vscode/.cache/mise && fish -c 'if test -f package.json; mise install && pnpm install --frozen-lockfile && pnpm playwright install chromium --with-deps; end'",
  "build": {
    "dockerfile": "Dockerfile",
    "cacheFrom": "type=registry,ref=ghcr.io/dhhyi/gin-rummy-scoreboard-devcontainer-cache"
  },
  "postStartCommand": "mise install",
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      "settings": {
        "chat.tools.terminal.terminalProfile.linux": {
          "path": "/usr/bin/bash"
        },
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "emmet.includeLanguages": {
          "vue": "html",
          "vue-html": "html"
        },
        "files.exclude": {
          ".devcontainer": true,
          ".update_devcontainer.sh": true,
          ".vscode": true
        },
        "terminal.integrated.automationProfile.linux": {
          "path": "/usr/bin/bash"
        },
        "terminal.integrated.defaultProfile.linux": "tmux-reuse",
        "terminal.integrated.profiles.linux": {
          "tmux-reuse": {
            "args": ["new-session", "-A", "-s", "vscode"],
            "icon": "terminal-tmux",
            "path": "/usr/bin/tmux"
          }
        }
      },
      "extensions": [
        "Vue.volar",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "streetsidesoftware.code-spell-checker",
        "bierner.markdown-preview-github-styles",
        "bierner.markdown-mermaid",
        "github.vscode-github-actions",
        "yzhang.markdown-all-in-one",
        "redhat.vscode-yaml",
        "aaron-bond.better-comments",
        "peakchen90.open-html-in-browser",
        "AntiAntiSepticeye.vscode-color-picker",
        "ms-playwright.playwright"
      ]
    }
  }
}
